<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Kafka system for StoveDotnet: Testcontainers Kafka (or an existing broker) with black-box publish, published, consumed and failed assertions.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="Testcontainers.Kafka" />
    <ProjectReference Include="..\StoveDotnet\StoveDotnet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The registry container joins a network owned by the Kafka system; that plumbing is not public API. -->
    <InternalsVisibleTo Include="StoveDotnet.SchemaRegistry" />
  </ItemGroup>

</Project>
