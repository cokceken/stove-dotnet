<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>In-process WireMock.Net fakes for third-party HTTP APIs in StoveDotnet tests, with OpenAPI-style path templates, typed request capture and per-test stub cleanup.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="WireMock.Net.Minimal" />
    <!--
      WireMock.Net.Minimal 2.19.0 resolves Microsoft.AspNetCore.WebUtilities 2.3.0 through Microsoft.AspNetCore.Http,
      which is affected by GHSA-6527-9fp8-r4x6 (fixed in 2.3.14). Referencing the patched version here also lifts it
      for projects consuming this package. Remove once WireMock.Net depends on a patched version itself.
    -->
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" />
    <ProjectReference Include="..\StoveDotnet\StoveDotnet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Works around an upstream packaging issue for every project consuming this package; see the targets file. -->
    <None Include="buildTransitive\StoveDotnet.WireMock.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

</Project>
